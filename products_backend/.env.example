# Ocean Professional - Products Backend
# Copy this file to .env and fill in values for your environment.

# Server configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Database connection (products_database dependency)
# Provide either PRODUCTS_DATABASE_URL or DATABASE_URL.
# Example for Postgres:
# PRODUCTS_DATABASE_URL=postgres://user:password@hostname:5432/products_db
# DATABASE_URL=postgres://user:password@hostname:5432/products_db
